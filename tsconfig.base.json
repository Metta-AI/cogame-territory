{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@cogweb/protocol": ["packages/protocol/src/index.ts"],
      "@cogweb/core": ["packages/core/src/index.ts"],
      "@cogweb/coworld": ["packages/coworld/src/index.ts"],
      "@cogweb/llm": ["packages/llm/src/index.ts"],
      "@cogweb/ui": ["packages/ui/src/index.ts"]
    },
    "noEmit": true
  }
}
